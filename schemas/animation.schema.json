{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/animation.schema.json",
  "title": "2D Sprite Studio Animation Specification",
  "type": "object",
  "required": [
    "animation_id",
    "asset_id",
    "animation_name",
    "frame_count",
    "frame_rate",
    "loop",
    "canvas_width",
    "canvas_height",
    "pivot_x",
    "pivot_y",
    "frame_sequence"
  ],
  "additionalProperties": true,
  "properties": {
    "animation_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "animation_name": { "type": "string" },
    "frame_count": { "type": "integer", "minimum": 1 },
    "frame_rate": { "type": "number", "exclusiveMinimum": 0 },
    "loop": { "type": "boolean" },
    "loop_type": { "type": "string" },
    "canvas_width": { "type": "integer", "minimum": 1 },
    "canvas_height": { "type": "integer", "minimum": 1 },
    "pivot_x": { "type": "number" },
    "pivot_y": { "type": "number" },
    "direction": { "type": "string" },
    "movement_description": { "type": "string" },
    "frame_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame", "pose"],
        "additionalProperties": true,
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "pose": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 1 },
          "notes": { "type": "string" },
          "ground_offset": { "type": "number" }
        }
      }
    },
    "transition_requirements": { "type": ["string", "array"], "items": { "type": "string" } },
    "visual_constraints": { "type": ["string", "array"], "items": { "type": "string" } },
    "sprite_sheet": { "type": "object", "additionalProperties": true }
  }
}
