{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/asset_brief.schema.json",
  "title": "2D Sprite Studio Asset Brief",
  "type": "object",
  "required": ["asset_id", "asset_name", "asset_category"],
  "additionalProperties": true,
  "properties": {
    "asset_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "asset_name": { "type": "string", "minLength": 1 },
    "asset_category": { "type": "string", "minLength": 1 },
    "asset_subcategory": { "type": "string" },
    "description": { "type": "string" },
    "intended_game": { "type": "string" },
    "intended_use": { "type": "string" },
    "theme": { "type": "string" },
    "art_style": { "type": "string" },
    "style_reference": { "type": ["string", "array"], "items": { "type": "string" } },
    "visual_reference": { "type": ["string", "array"], "items": { "type": "string" } },
    "camera": { "type": "string" },
    "perspective": { "type": "string" },
    "view_direction": { "type": "string" },
    "canvas_width": { "type": "integer", "minimum": 1 },
    "canvas_height": { "type": "integer", "minimum": 1 },
    "target_width": { "type": "integer", "minimum": 1 },
    "target_height": { "type": "integer", "minimum": 1 },
    "background": { "type": "string" },
    "transparency_required": { "type": "boolean" },
    "colour_palette": { "type": ["array", "string"], "items": { "type": "string" } },
    "outline_style": { "type": "string" },
    "lighting_direction": { "type": "string" },
    "shading_style": { "type": "string" },
    "pivot": {
      "type": "object",
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "required": ["x", "y"],
      "additionalProperties": true
    },
    "anchor_point": { "type": "string" },
    "ground_contact": { "type": ["string", "number", "null"] },
    "animation_required": { "type": "boolean" },
    "animation_type": { "type": "string" },
    "frame_count": { "type": "integer", "minimum": 1 },
    "frame_rate": { "type": "number", "exclusiveMinimum": 0 },
    "looping": { "type": "boolean" },
    "animation_direction": { "type": "string" },
    "target_engine": { "type": "string" },
    "export_format": { "type": "string" },
    "quality_requirements": { "type": ["array", "string"], "items": { "type": "string" } },
    "special_constraints": { "type": ["array", "string"], "items": { "type": "string" } },
    "negative_constraints": { "type": ["array", "string"], "items": { "type": "string" } },
    "license": { "type": "string" },
    "custom": { "type": "object", "additionalProperties": true }
  }
}
