# Copy to .env for local use. Never commit .env or real credentials.
#
# The CLI reads these values from the process environment. It does not load .env
# automatically; use your shell, a process manager, or `python-dotenv` yourself.
# Do not put a secret in a prompt, URL, manifest, log or screenshot.

# --- Perchance modes -------------------------------------------------------
# manual              Prepare prompt + browser handoff (no key required).
# developer_api       Documented PerchanceAI API (requires PERCHANCEAI_API_KEY).
# documented_tutorial Unsupported: tested endpoint returned HTTP 404 on 2026-11-12.
PERCHANCE_MODE=manual

# --- PerchanceAI developer API --------------------------------------------
# Create an account key in the PerchanceAI dashboard. The secret is shown once.
# Leave blank for manual mode and for public model discovery.
PERCHANCEAI_API_KEY=

# Do not change unless PerchanceAI publishes a different versioned base URL.
PERCHANCEAI_API_BASE_URL=https://api.perchanceai.art/api/v1/developer

# Optional application identifier sent in X-App-Id.
PERCHANCEAI_APP_ID=perchanceai

# Manual handoff target. Replace with the specific generator you intend to use.
PERCHANCE_GENERATOR_URL=https://perchance.org/ai-text-to-image-generator

# --- Cost and polling safety ----------------------------------------------
PERCHANCE_MAX_CREDITS=50
PERCHANCE_REQUIRE_APPROVAL=true
PERCHANCE_TIMEOUT=60
PERCHANCE_POLL_INTERVAL=2
PERCHANCE_MAX_POLLS=150

# --- Local output (relative to the workspace root) -------------------------
PERCHANCE_OUTPUT_DIR=projects/example-project/assets/source/perchance
PERCHANCE_IDEMPOTENCY_STORE=projects/example-project/manifests/idempotency.jsonl

# --- Optional model hint ---------------------------------------------------
# Prefer discovering the current catalog with tools/generate_asset.py models.
PERCHANCE_MODEL_KEY=
